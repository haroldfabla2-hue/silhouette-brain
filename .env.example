# ============================================================================
# Silhouette Brain - Variables de Entorno
# ============================================================================

# ── 1. Motor de Razonamiento / Síntesis (Opcional pero recomendado) ─────────
# Providers soportados: 'minimax', 'openai', 'anthropic', 'zhipu'
REASONING_PROVIDER=minimax
REASONING_API_KEY=tu_clave_api_aqui
REASONING_MODEL=MiniMax-M2.5

# Ejemplos de otros providers:
# REASONING_PROVIDER=openai
# REASONING_API_KEY=sk-proj-tu-clave-aqui
# REASONING_MODEL=gpt-4o-mini

# ── 2. Embeddings (Locales y gratuitos) ────────────────────────────────────
# No requieren clave API. Se descargan y ejecutan localmente usando ONNX.
FASTEMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ── 3. Base de Datos de Grafos (Neo4j) ──────────────────────────────────────
# Credenciales para el contenedor Docker de Neo4j (Deep Memory)
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# ── 4. Otras configuraciones (opcional) ─────────────────────────────────────
# REDIS_URL=redis://localhost:6379